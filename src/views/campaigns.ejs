<%- include('partials/header', { title: 'Campaigns', user }) %>
<div class="container">
  <div class="flex justify-between items-center mb-4">
    <h2>Manajemen Campaign</h2>
    <a href="/bi/dashboard" class="btn secondary">Kembali</a>
  </div>
  <div class="card p-4">
    <form method="post" action="/bi/campaigns" class="grid" style="grid-template-columns: 1fr 1fr; gap: 1rem;" onsubmit="const btn = this.querySelector('button[type=submit]') || this.querySelector('button'); if(btn){ btn.disabled = true; btn.textContent = 'Memproses...'; }">
      <div><label for="name">Nama Campaign <span aria-hidden="true" style="color: var(--danger)">*</span></label><input id="name" name="name" required /></div>
      <div><label for="target">Target <span aria-hidden="true" style="color: var(--danger)">*</span></label><input id="target" name="target" required /></div>
      <div><label for="startDate">Tanggal Mulai <span aria-hidden="true" style="color: var(--danger)">*</span></label><input id="startDate" type="date" name="startDate" required /></div>
      <div><label for="endDate">Tanggal Selesai <span aria-hidden="true" style="color: var(--danger)">*</span></label><input id="endDate" type="date" name="endDate" required /></div>
      <button class="btn" type="submit" style="grid-column: span 2;">Buat Campaign</button>
    </form>
  </div>
  <div class="card mt-4 p-4">
    <table class="table" style="width: 100%; border-collapse: collapse;">
      <thead>
        <tr style="background: var(--bg-alt); text-align: left;">
          <th style="padding: 0.75rem; border-bottom: 1px solid var(--border);">Nama Campaign</th>
          <th style="padding: 0.75rem; border-bottom: 1px solid var(--border);">Target</th>
          <th style="padding: 0.75rem; border-bottom: 1px solid var(--border);">Mulai</th>
          <th style="padding: 0.75rem; border-bottom: 1px solid var(--border);">Selesai</th>
        </tr>
      </thead>
      <tbody>
        <% if (campaigns.length > 0) { %>
          <% campaigns.forEach(c => { %>
            <tr>
              <td style="padding: 0.75rem; border-bottom: 1px solid var(--border);"><%= c.name %></td>
              <td style="padding: 0.75rem; border-bottom: 1px solid var(--border);"><%= c.target %></td>
              <td style="padding: 0.75rem; border-bottom: 1px solid var(--border);"><%= new Date(c.startDate).toLocaleDateString('id-ID') %></td>
              <td style="padding: 0.75rem; border-bottom: 1px solid var(--border);"><%= new Date(c.endDate).toLocaleDateString('id-ID') %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="4" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto 1rem; opacity: 0.5;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              <div>Belum ada data campaign. Silakan isi form di atas untuk membuat campaign baru.</div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
</body>
</html>
