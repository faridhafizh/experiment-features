<%- include('partials/header', { title: 'Merchants', user }) %>
<div class="container">
  <div class="flex justify-between items-center mb-4">
    <h2>Manajemen Merchant</h2>
    <a href="/pjp/dashboard" class="btn secondary">Kembali</a>
  </div>
  <div class="card p-4">
    <form method="post" action="/pjp/merchants" class="grid" style="grid-template-columns: 1fr 1fr 1fr; gap: 1rem; align-items: end;" onsubmit="const btn = this.querySelector('button[type=submit]'); if(btn) { btn.disabled = true; btn.textContent = 'Memproses...'; }">
      <div><label for="name">Nama Merchant <span aria-hidden="true" style="color: var(--danger)">*</span></label><input id="name" name="name" required /></div>
      <div><label for="category">Kategori <span aria-hidden="true" style="color: var(--danger)">*</span></label><input id="category" name="category" required /></div>
      <div>
        <label for="status">Status <span aria-hidden="true" style="color: var(--danger)">*</span></label>
        <select id="status" name="status" required>
          <option value="prospect">Prospect</option>
          <option value="in_progress">In Progress</option>
          <option value="completed">Completed</option>
        </select>
      </div>
      <button class="btn" type="submit" style="grid-column: span 3;">Tambah Merchant</button>
    </form>
  </div>
  <div class="card mt-4 p-4">
    <% if (merchants && merchants.length > 0) { %>
      <table class="table" style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr style="background: var(--bg-alt); text-align: left;">
            <th style="padding: 0.75rem; border-bottom: 1px solid var(--border);">Nama Merchant</th>
            <th style="padding: 0.75rem; border-bottom: 1px solid var(--border);">Kategori</th>
            <th style="padding: 0.75rem; border-bottom: 1px solid var(--border);">Status</th>
          </tr>
        </thead>
        <tbody>
          <% merchants.forEach(m => { %>
            <tr>
              <td style="padding: 0.75rem; border-bottom: 1px solid var(--border);"><%= m.name %></td>
              <td style="padding: 0.75rem; border-bottom: 1px solid var(--border);"><%= m.category %></td>
              <td style="padding: 0.75rem; border-bottom: 1px solid var(--border);"><%= m.status %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <div style="text-align: center; padding: 2rem 0; color: var(--text-muted);">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-bottom: 1rem; opacity: 0.5;">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        <p>Belum ada data merchant.</p>
      </div>
    <% } %>
  </div>
</div>
</body>
</html>
